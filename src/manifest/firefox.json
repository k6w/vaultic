{
  "manifest_version": 3,
  "name": "Vaultic",
  "version": "2.0.0",
  "description": "TOTP 2FA authenticator with temporary email — encrypted, cross-browser",
  "permissions": [
    "storage",
    "alarms",
    "menus",
    "activeTab",
    "scripting",
    "notifications",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": ["https://api.mail.tm/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://api.mail.tm; object-src 'none'; frame-src 'self'"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel/index.html",
    "default_title": "Vaultic"
  },
  "background": {
    "scripts": ["background/index.js"]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vaultic@extension"
    }
  }
}
